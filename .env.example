# Database (used by infra/docker-compose.yml and the backend service)
POSTGRES_USER=floodrelay
POSTGRES_PASSWORD=floodrelay_dev
POSTGRES_DB=floodrelay
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection string (convenience, built from the values above)
DATABASE_URL=postgresql://floodrelay:floodrelay_dev@localhost:5432/floodrelay

# Operator Authentication & Initial Bootstrap
# In local dev: if unset, an initial operator is provisioned when database is empty.
# In production: default credentials are automatically blocked; set a unique high-entropy password.
INITIAL_OPERATOR_USERNAME=eoc_operator
INITIAL_OPERATOR_PASSWORD=
INITIAL_OPERATOR_NAME="Capt. R. Vance"

# OSRM (Road network routing service)
# Set OSRM_BASE_URL to enable single-region road routing (e.g., http://localhost:5000). Leave blank for straight-line routing.
OSRM_BASE_URL=
OSRM_PROFILE=driving
OSRM_TIMEOUT_MS=5000
OSRM_MAX_TABLE_COORDINATES=100
OSRM_PORT=5000
# Optional coverage bounding box ("minLat,minLng,maxLat,maxLng" in decimal degrees) for OSRM_BASE_URL.
# Example for the New Delhi extract:
# OSRM_COVERAGE_BBOX=28.44,76.98,28.74,77.50
# Optional multi-region OSRM JSON array (when set, overrides OSRM_BASE_URL):
# OSRM_REGIONS=[{"id":"delhi","baseUrl":"http://localhost:5000","bbox":"28.44,76.98,28.74,77.50","profile":"driving"}]
# OSRM PBF extract URL covering the scenario area (for default `osrm` compose profile on port 5000).
# Left blank because extract URLs must be verified for your deployment before download.
OSRM_PBF_URL=
# Optional per-zone PBF extract URLs for India regional compose profiles (ports 5001-5006):
# OSRM_PBF_URL_NORTH=
# OSRM_PBF_URL_SOUTH=
# OSRM_PBF_URL_CENTRAL=
# OSRM_PBF_URL_EAST=
# OSRM_PBF_URL_WEST=
# OSRM_PBF_URL_NORTHEAST=

# Reverse Geocoding Service (Geoapify)
# Server-side API key for Citizen Portal GPS address autofill.
# Place in apps/web/.env.local (do NOT prefix with NEXT_PUBLIC_)
GEOAPIFY_API_KEY=

# Optional Map Tile Provider Override (defaults to OpenStreetMap raster tiles)
# NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

